# Copy the API values to apps/api/.env for Docker Compose or local API runs.
# Replace every CHANGE_ME value before using Atlas outside local development.

# Application
APP_NAME=Atlas
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_32_BYTE_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
INTEGRATION_ENCRYPTION_KEY=

# Docker Compose service names. Use localhost for direct host execution.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# Claim evidence storage. Production requires S3-compatible durable storage and
# malware scanning. Leave local/disabled only for developer workstations.
DOCUMENT_STORAGE_BACKEND=local
DOCUMENT_LOCAL_STORAGE_ROOT=uploads/documents
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_PREFIX=documents
DOCUMENT_S3_REGION=
DOCUMENT_S3_ENDPOINT_URL=
DOCUMENT_S3_SERVER_SIDE_ENCRYPTION=AES256
DOCUMENT_S3_KMS_KEY_ID=
DOCUMENT_MALWARE_SCAN_ENABLED=false
DOCUMENT_MALWARE_SCAN_HOST=clamav
DOCUMENT_MALWARE_SCAN_PORT=3310
DOCUMENT_MALWARE_SCAN_TIMEOUT_SECONDS=10

# Recovery opportunity scoring thresholds, in the organization's currency.
RECOVERY_DEFAULT_COST_TO_RECOVER=25.00
RECOVERY_CRITICAL_EXPECTED_AMOUNT=100000.00
RECOVERY_HIGH_EXPECTED_AMOUNT=25000.00
RECOVERY_DEFAULT_COLLECTION_DAYS=90

# AI
AI_PROVIDER=openai
AI_MODEL=gpt-4.1
AI_MODEL_FAST=gpt-4.1-mini
OPENAI_API_KEY=
COPILOT_ENABLED=true

# Email. Empty SMTP_HOST keeps local delivery in explicit log-only mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@atlas.health
SMTP_USE_TLS=true

# Web values belong in apps/web/.env.local.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_QUERY_DEVTOOLS=false
